{
  "rules": {
    "users": {
      ".indexOn": ["role"],
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin')"
      }
    },
    "services": {
      ".indexOn": ["serviceProviderId", "category"],
      ".read": "auth != null",
      "$serviceId": {
        ".write": "auth != null && (newData.child('serviceProviderId').val() == auth.uid || data.child('serviceProviderId').val() == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'admin')"
      }
    },
    "jobs": {
      ".indexOn": ["status", "workerId", "clientId"],
      ".read": "auth != null",
      "$jobId": {
        ".write": "auth != null && (newData.child('clientId').val() == auth.uid || data.child('clientId').val() == auth.uid || data.child('workerId').val() == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'admin')"
      }
    },
    "quotes": {
      "$jobId": {
        ".read": "auth != null",
        "$workerId": {
          ".write": "auth != null && auth.uid == $workerId"
        }
      }
    },
    "bookings": {
      ".indexOn": ["workerId", "clientId"],
      ".read": "auth != null",
      "$bookingId": {
        ".write": "auth != null && (newData.child('clientId').val() == auth.uid || data.child('clientId').val() == auth.uid || data.child('workerId').val() == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'admin')"
      }
    },
    "user_chats": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "messages": {
      "$chatId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "admin_wallet": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "admin_revenue": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "activity_log": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "disputes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "emergency_requests": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "saved_services": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null"
      }
    },
    "broadcasts": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "withdrawal_requests": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "transactions": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
