{
  "rules": {
    "users": {
      ".indexOn": ["role"],
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        "isSuspended": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
        },
        "role": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin' && !data.exists()"
        }
      }
    },
    "jobs": {
      ".indexOn": ["status", "workerId", "clientId"],
      ".read": "auth != null && root.child('users').child(auth.uid).child('isSuspended').val() != true",
      "$jobId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('isSuspended').val() != true && ((!data.exists() && newData.child('clientId').val() == auth.uid) || (data.exists() && data.child('clientId').val() == auth.uid) || (data.exists() && data.child('workerId').val() == auth.uid) || (root.child('users').child(auth.uid).child('role').val() == 'admin'))",
        "quotedAmount": {
           ".write": "auth != null && (data.parent().child('clientId').val() == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'admin')"
        },
        "status": {
           ".write": "auth != null && ((data.parent().child('clientId').val() == auth.uid) || (data.parent().child('workerId').val() == auth.uid) || (root.child('users').child(auth.uid).child('role').val() == 'admin'))"
        }
      }
    },
    "quotes": {
      "$jobId": {
        ".read": "auth != null && (root.child('jobs').child($jobId).child('clientId').val() == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        "$workerId": {
          ".read": "auth != null && (auth.uid == $workerId || root.child('jobs').child($jobId).child('clientId').val() == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
          ".write": "auth != null && auth.uid == $workerId && root.child('users').child(auth.uid).child('isSuspended').val() != true && root.child('users').child(auth.uid).child('role').val() == 'worker'"
        }
      }
    },
    "bookings": {
      ".indexOn": ["workerId", "clientId"],
      ".read": "auth != null && root.child('users').child(auth.uid).child('isSuspended').val() != true",
      "$bookingId": {
        ".read": "auth != null && (data.child('clientId').val() == auth.uid || data.child('workerId').val() == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
      }
    }
  }
}
