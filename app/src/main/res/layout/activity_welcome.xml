<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background_gradient">

    <!-- Global Banner Header, using the same gradient as the buttons for consistency -->
    <TextView
        android:id="@+id/globalBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/animated_gradient_splash"
        android:padding="20dp"
        android:text="@string/welcome_banner"
        android:textColor="@color/text_on_gradient"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Logo sits in a soft circular gradient badge instead of floating bare -->

    <!-- Role Selection Card -->

    <View
        android:id="@+id/logoBackdrop"
        android:layout_width="119dp"
        android:layout_height="124dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/logo_circle_gradient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.43"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/globalBanner" />

    <ImageView
        android:id="@+id/logo"
        android:layout_width="169dp"
        android:layout_height="160dp"
        android:src="@drawable/hustlefix_logo"
        app:layout_constraintBottom_toBottomOf="@id/logoBackdrop"
        app:layout_constraintEnd_toEndOf="@id/logoBackdrop"
        app:layout_constraintHorizontal_bias="0.468"
        app:layout_constraintStart_toStartOf="@id/logoBackdrop"
        app:layout_constraintTop_toTopOf="@+id/logoBackdrop" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardBackgroundColor="@color/card_surface_translucent"
        app:cardCornerRadius="28dp"
        app:cardElevation="12dp"
        app:strokeColor="@color/brand_primary"
        app:strokeWidth="0.5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoBackdrop"
        app:layout_constraintVertical_bias="0.3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/welcome_hustle"
                android:textColor="@color/text_low_emphasis"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="32dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/select_role"
                android:textColor="@color/brand_primary_dark"
                android:textSize="24sp" />

            <!-- Gradient Buttons, unified with the theme drawable -->
            <Button
                android:id="@+id/btnServiceProvider"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/gradient_button"
                android:text="@string/provider_role"
                android:textColor="@color/text_on_gradient"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:elevation="6dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnClient"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/gradient_button"
                android:text="@string/client_role"
                android:textColor="@color/text_on_gradient"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:elevation="6dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/design_champions"
        android:textColor="@color/brand_primary_dark"
        android:textStyle="bold"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>