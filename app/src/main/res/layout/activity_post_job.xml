<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:fitsSystemWindows="true">

        <!-- App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primaryPurple"
            app:title="Post a Job"
            app:titleTextColor="@android:color/white"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@android:color/white"
            app:menu="@menu/menu_post_job" />

        <!-- Form Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/gradient_post_job_background"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="24dp">

                <!-- Form Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Job Title -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Job Title"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#2C3E50"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:hintTextColor="#667eea"
                            app:boxStrokeColor="#667eea">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="e.g. Need a Plumber"
                                android:inputType="textCapWords"
                                android:textColor="#2C3E50" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Job Description -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Job Description"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#2C3E50"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:hintTextColor="#667eea"
                            app:boxStrokeColor="#667eea">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDescription"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Describe the job requirements..."
                                android:minLines="4"
                                android:gravity="top"
                                android:inputType="textMultiLine"
                                android:textColor="#2C3E50" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Category Section -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Select Category"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#2C3E50"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupCategory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:singleSelection="true"
                            app:chipSpacing="8dp">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPlumber"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔧 Plumber"
                                app:chipBackgroundColor="#F0F0F0"
                                android:textColor="#2C3E50"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipElectrician"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⚡ Electrician"
                                app:chipBackgroundColor="#F0F0F0"
                                android:textColor="#2C3E50"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipCarpenter"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🪚 Carpenter"
                                app:chipBackgroundColor="#F0F0F0"
                                android:textColor="#2C3E50"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPainter"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🎨 Painter"
                                app:chipBackgroundColor="#F0F0F0"
                                android:textColor="#2C3E50"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipCleaner"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🧹 Cleaner"
                                app:chipBackgroundColor="#F0F0F0"
                                android:textColor="#2C3E50"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipMechanic"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔧 Mechanic"
                                app:chipBackgroundColor="#F0F0F0"
                                android:textColor="#2C3E50"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipGardener"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🌿 Gardener"
                                app:chipBackgroundColor="#F0F0F0"
                                android:textColor="#2C3E50"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipOther"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📌 Other"
                                app:chipBackgroundColor="#F0F0F0"
                                android:textColor="#2C3E50"
                                android:checkable="true" />

                        </com.google.android.material.chip.ChipGroup>

                        <!-- Budget & Deadline Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">

                            <!-- Budget -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Budget"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="#2C3E50"
                                    android:layout_marginBottom="8dp" />

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:boxCornerRadiusTopStart="12dp"
                                    app:boxCornerRadiusTopEnd="12dp"
                                    app:boxCornerRadiusBottomStart="12dp"
                                    app:boxCornerRadiusBottomEnd="12dp"
                                    app:startIconDrawable="@drawable/ic_currency"
                                    app:startIconTint="#667eea"
                                    app:hintTextColor="#667eea"
                                    app:boxStrokeColor="#667eea">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etBudget"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:hint="Amount"
                                        android:inputType="numberDecimal"
                                        android:textColor="#2C3E50" />

                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>

                            <!-- Deadline -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Deadline"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:textColor="#2C3E50"
                                    android:layout_marginBottom="8dp" />

                                <com.google.android.material.textfield.TextInputLayout
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:boxCornerRadiusTopStart="12dp"
                                    app:boxCornerRadiusTopEnd="12dp"
                                    app:boxCornerRadiusBottomStart="12dp"
                                    app:boxCornerRadiusBottomEnd="12dp"
                                    app:startIconDrawable="@drawable/ic_calendar"
                                    app:startIconTint="#667eea"
                                    app:hintTextColor="#667eea"
                                    app:boxStrokeColor="#667eea">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etDeadline"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:hint="Select Date"
                                        android:inputType="date"
                                        android:focusable="false"
                                        android:textColor="#2C3E50" />

                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Location -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Location"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#2C3E50"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:startIconDrawable="@drawable/ic_location"
                            app:startIconTint="#667eea"
                            app:hintTextColor="#667eea"
                            app:boxStrokeColor="#667eea">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etLocation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="e.g. Johannesburg, CBD"
                                android:inputType="textCapWords"
                                android:textColor="#2C3E50" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Attachments Section -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Attachments (Optional)"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#2C3E50"
                            android:layout_marginBottom="8dp" />

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardAttachment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp"
                            app:cardBackgroundColor="#F8F9FA"
                            android:layout_marginBottom="16dp"
                            android:clickable="true"
                            android:focusable="true">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:padding="16dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_attach"
                                    android:tint="#667eea" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Add attachments (images, documents)"
                                    android:textSize="13sp"
                                    android:textColor="#95A5A6"
                                    android:layout_marginStart="12dp" />

                                <TextView
                                    android:id="@+id/tvAttachmentsCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="#667eea" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- Urgency Level -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Urgency Level"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#2C3E50"
                            android:layout_marginBottom="12dp" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/toggleUrgency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="24dp"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnNormal"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Normal"
                                android:textSize="12sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnUrgent"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="Urgent"
                                android:textSize="12sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEmergency"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:text="🚨 Emergency"
                                android:textSize="12sp" />

                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <!-- Post Job Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubmitJob"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:text="POST JOB"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            app:cornerRadius="28dp"
                            app:backgroundTint="#667eea"
                            android:elevation="2dp" />

                        <!-- Progress Bar -->
                        <ProgressBar
                            android:id="@+id/progressBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:visibility="gone"
                            android:layout_marginTop="16dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header_dashboard"
        app:menu="@menu/navigation_menu"
        app:itemIconTint="@color/drawer_item_color"
        app:itemTextColor="@color/drawer_item_color"
        app:itemBackground="@android:color/transparent"
        app:itemIconPadding="12dp" />

</androidx.drawerlayout.widget.DrawerLayout>