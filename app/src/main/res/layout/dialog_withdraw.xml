<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter Withdrawal Details"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/brand_primary"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/etWithdrawAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Amount to withdraw (ZAR)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Bank"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rgBank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">
        <RadioButton android:id="@+id/rbCapitec" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Capitec" />
        <RadioButton android:id="@+id/rbFNB" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FNB" />
        <RadioButton android:id="@+id/rbStandard" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Standard Bank" />
        <RadioButton android:id="@+id/rbAbsa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Absa" />
        <RadioButton android:id="@+id/rbNedbank" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nedbank" />
    </RadioGroup>

    <EditText
        android:id="@+id/etAccountNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Account Number"
        android:inputType="number" />

</LinearLayout>
